# ============================================================================
# Airborne – Umgebungsvariablen (Beispiel)
# Kopieren zu .env und Werte setzen. .env NIE committen (in .gitignore!).
# ============================================================================

# --- LLM (Text-Generierung: Prompts, Merge, Missionsplan) -------------------
# OpenAI-kompatibel (OpenAI, OpenRouter, lokale Ollama/OpenAI-kompatible Endpoints)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
# Alternativ/Cloud-unabhängig:
# OPENAI_API_BASE=http://localhost:11434/v1   # Ollama
# OPENAI_MODEL=gpt-5.3-flash                  # Modellbezeichnung je Provider

# --- ElevenLabs (Text-to-Speech fuer Funksprueche, optional, Phase 2) -------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Pfade IL-2 Korea -------------------------------------------------------
# Root der Installation (enthält data\, bin\)
IL2_ROOT=C:\Program Files (x86)\Steam\steamapps\common\IL2Series
# Editor-Exe; Start zwingend mit Arbeitsverzeichnis = bin\editor (sonst gtp-Paketfehler!)
IL2_EDITOR=C:\Program Files (x86)\Steam\steamapps\common\IL2Series\bin\editor\IL2Editor.exe
# Ablageort eigener Missionen ( beliebig, z. B. OneDrive wie bisher )
IL2_MISSIONS_DIR=C:\Users\vince\OneDrive\Persönliches

# --- Pfade DCS World --------------------------------------------------------
# Saved Games Root (Missions-Output nach DCS_MISSIONS_DIR\Missions\)
DCS_SAVED_GAMES=C:\Users\vince\Saved Games\DCS
# Installationsroot (Karten-/Modul-Check, optional)
DCS_ROOT=C:\Program Files\Eagle Dynamics\DCS World
# Optional: abweichender Missions-Ausgabeordner (Standard: DCS_SAVED_GAMES\Missions)
# DCS_MISSIONS_DIR=

# Max. Output-Tokens (wichtig bei Reasoning-Modellen: Denken + Antwort muessen rein)
OPENAI_MAX_TOKENS=30000
